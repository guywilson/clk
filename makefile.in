###############################################################################
#                                                                             #
# MAKEFILE for clk (generated by configure)                                    #
#                                                                             #
# (c) Guy Wilson 2026                                                         #
#                                                                             #
###############################################################################

# Version number for clk
MAJOR_VERSION = 1
MINOR_VERSION = 0

# Directories
srcdir = @srcdir@
prefix = @prefix@
exec_prefix = @exec_prefix@
bindir = @bindir@
datarootdir = @datarootdir@
mandir = @mandir@

SOURCE = $(srcdir)/src
BUILD = build
DEP = dep
DOC = $(srcdir)/doc

MANSOURCE = $(DOC)/clk.1.md

# What is our target
TARGET = clk
MANTARGET = $(TARGET).1

# Tools
VBUILD = @VBUILD@
C = @CC@
CXX = @CXX@
LINKER = $(CXX)
PANDOC = @PANDOC@

# Additional flags supplied to configure or make.
CPPFLAGS =@CPPFLAGS@
CFLAGS =@CFLAGS@
CXXFLAGS =@CXXFLAGS@
LDFLAGS =@LDFLAGS@
LIBS =@LIBS@

# postcompile step
PRECOMPILE = @ mkdir -p $(BUILD) $(DEP)
# postcompile step
POSTCOMPILE = @ mv -f $(DEP)/$*.Td $(DEP)/$*.d

COMMON_FLAGS=-c -Wall -pedantic
DEP_FLAGS=-MT $@ -MMD -MP -MF $(DEP)/$*.Td

CFLAGS_BASE=$(COMMON_FLAGS)
CFLAGS_REL=$(CFLAGS_BASE) -O2 $(DEP_FLAGS)
CFLAGS_DBG=$(CFLAGS_BASE) -g -O0 $(DEP_FLAGS)

CXXFLAGS_BASE=$(COMMON_FLAGS) -std=c++20
CXXFLAGS_REL=$(CXXFLAGS_BASE) -O2 $(DEP_FLAGS)
CXXFLAGS_DBG=$(CXXFLAGS_BASE) -g -O0 $(DEP_FLAGS)

ifndef DEBUG
CXX_COMPILE_FLAGS=$(CXXFLAGS_REL)
C_COMPILE_FLAGS=$(CFLAGS_REL)
else
CXX_COMPILE_FLAGS=$(CXXFLAGS_DBG)
C_COMPILE_FLAGS=$(CFLAGS_DBG)
endif

PANDOCFLAGS = -s -t man

# Libraries
STDLIBS=
EXTLIBS=-lgcrypt -lpng

COMPILE.cpp=$(CXX) $(CPPFLAGS) $(CXXFLAGS) $(CXX_COMPILE_FLAGS) -o $@
COMPILE.c=$(C) $(CPPFLAGS) $(CFLAGS) $(C_COMPILE_FLAGS) -o $@
LINK.o=$(LINKER) $(LDFLAGS) -o $@

PANDOC.md = $(PANDOC) $(PANDOCFLAGS) -o $@

CSRCFILES = $(wildcard $(SOURCE)/*.c)
CPPSRCFILES = $(wildcard $(SOURCE)/*.cpp)
OBJFILES = $(patsubst $(SOURCE)/%.c, $(BUILD)/%.o, $(CSRCFILES)) $(patsubst $(SOURCE)/%.cpp, $(BUILD)/%.o, $(CPPSRCFILES))
DEPFILES = $(patsubst $(SOURCE)/%.c, $(DEP)/%.d, $(CSRCFILES)) $(patsubst $(SOURCE)/%.cpp, $(DEP)/%.d, $(CPPSRCFILES))

.PHONY: all install version clean

all: $(TARGET) $(MANTARGET)

# Compile C/C++ source files
#
$(TARGET): $(OBJFILES)
	$(LINK.o) $^ $(EXTLIBS) $(LIBS)

$(BUILD)/%.o: $(SOURCE)/%.c
$(BUILD)/%.o: $(SOURCE)/%.c $(DEP)/%.d
	$(PRECOMPILE)
	$(COMPILE.c) $<
	$(POSTCOMPILE)

$(BUILD)/%.o: $(SOURCE)/%.cpp
$(BUILD)/%.o: $(SOURCE)/%.cpp $(DEP)/%.d
	$(PRECOMPILE)
	$(COMPILE.cpp) $<
	$(POSTCOMPILE)

$(MANTARGET): $(MANSOURCE)
	$(PANDOC.md) $<

.PRECIOUS: $(DEP)/%.d
$(DEP)/%.d: ;

-include $(DEPFILES)

install: all
	mkdir -p "$(DESTDIR)$(bindir)" "$(DESTDIR)$(mandir)/man1"
	cp $(TARGET) "$(DESTDIR)$(bindir)/"
	cp $(MANTARGET) "$(DESTDIR)$(mandir)/man1/"

version:
	$(VBUILD) -i $(srcdir)/$(TARGET).ver -t $(srcdir)/version.c.template -o $(SOURCE)/version.c -major $(MAJOR_VERSION) -minor $(MINOR_VERSION)

clean:
	rm -rf $(BUILD)
	rm -rf $(DEP)
	rm -f $(TARGET)
	rm -f $(TARGET).1
